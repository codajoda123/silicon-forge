  {
    "id": "io-pads",
    "name": "I/O pads",
    "category": "io",
    "description": "Edge-only pads. Pin count is limited by the package.",
    "historicalYear": 1971,
    "edgeOnly": true,
    "configSchema": {
      "dataPins": {
        "kind": "integer",
        "label": "Data pins",
        "min": 4,
        "max": 64,
        "default": 4
      },
      "addressPins": {
        "kind": "integer",
        "label": "Address pins",
        "min": 0,
        "max": 32,
        "default": 0
      },
      "controlPins": {
        "kind": "integer",
        "label": "Control pins",
        "min": 2,
        "max": 16,
        "default": 2
      }
    },
    "transistors": "(dataPins + addressPins + controlPins) * 50",
    "logicDepth": "3",
    "activity": {},
    "requiredLinks": [
      {
        "to": "bus-interface",
        "widthBits": "dataPins",
        "timing": "critical"
      }
    ]
  },
  {
    "id": "custom-unit",
    "name": "Custom instruction unit",
    "category": "accelerator",
    "description": "Executes one macro-instruction pattern quickly; dead area for other workloads.",
    "historicalYear": 1975,
    "configSchema": {
      "width": {
        "kind": "enum",
        "label": "Data width",
        "values": [
          4,
          8,
          16,
          32
        ],
        "default": 8
      },
      "latencyCycles": {
        "kind": "integer",
        "label": "Latency (cycles)",
        "min": 1,
        "max": 16,
        "default": 2
      }
    },
    "transistors": "1500 + 120 * width + 200 * latencyCycles",
    "logicDepth": "10 + 2 * latencyCycles",
    "activity": {},
    "requiredLinks": [
      {
        "to": "register-file",
        "widthBits": "width",
        "timing": "normal"
      }
    ],
    "unitFor": [
      "simd"
    ]
  }
]
